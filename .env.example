BOT_TOKEN=your_telegram_bot_token_here
LOG_LEVEL=INFO
# Використовується API, Alembic і PostgreSQL checkpointer AI-чату.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database_name?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_SESSION_SECRET=change_this_random_session_secret
# Для локального HTTP залиште false. Dockerfile.render установлює true для HTTPS Render.
ADMIN_SESSION_COOKIE_SECURE=false
# Використовується одноразовим аналізом і AI-помічником.
LLM_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
# Локальні runtime-шляхи; у Docker перевизначаються змінними середовища контейнера api.
AI_RECEIPT_STORAGE_DIR=runtime/ai-receipts
AI_AUDIT_LOG_DIR=runtime/ai-audit
AI_RECEIPT_RETENTION_DAYS=180
AI_AUDIT_LOG_RETENTION_DAYS=30
