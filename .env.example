BOT_TOKEN=your_telegram_bot_token_here
LOG_LEVEL=INFO
# Використовується API, Alembic і PostgreSQL checkpointer AI-чату.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database_name?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_SESSION_SECRET=change_this_random_session_secret
VITE_APP_VARIANT=local
VITE_API_BASE_URL=http://localhost:8000
# Для локального HTTP залиште false. Dockerfile.render установлює true для HTTPS Render.
ADMIN_SESSION_COOKIE_SECURE=false
# Використовується одноразовим аналізом і AI-помічником.
LLM_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
# Локальні runtime-шляхи; у Docker перевизначаються змінними середовища контейнера api.
AI_RECEIPT_STORAGE_DIR=runtime/ai-receipts
AI_AUDIT_LOG_DIR=runtime/ai-audit
AI_RECEIPT_RETENTION_DAYS=180
AI_AUDIT_LOG_RETENTION_DAYS=30

# Optional private Google Drive receipt storage. Keep real values only in .env / Render.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_FOLDER_ID=your_private_drive_folder_id
GOOGLE_OAUTH_REDIRECT_URI=https://orest.onrender.com/api/admin/google-drive/callback
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_oauth_refresh_token
